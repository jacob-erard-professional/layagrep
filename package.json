{
  "name": "@nassim-arifette/layagrep",
  "version": "0.1.0",
  "description": "Local semantic code search for coding agents, powered by Laya.",
  "type": "module",
  "license": "MIT",
  "author": "Nassim Arifette",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacob-erard-professional/layagrep.git"
  },
  "homepage": "https://github.com/jacob-erard-professional/layagrep#readme",
  "bugs": {
    "url": "https://github.com/jacob-erard-professional/layagrep/issues"
  },
  "keywords": ["laya", "semantic-search", "code-search", "coding-agents", "mcp", "cli", "local-ai"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "bin": {
    "layagrep": "dist/cli.js"
  },
  "files": [
    "dist",
    "integrations",
    "runtime"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/make-executable.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\" \"tests/contract/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tiktoken": "1.0.22",
    "typescript-parser": "npm:typescript@6.0.2"
  }
}
